    <string name="doh3_warning">Musi być wybrany co najmniej jeden serwer</string>
    <string name="hagezi_dns_blocklists_description">Zagregowane listy blokowania różniące się wielkością. Blokuje reklamy, śledzenie, dane statystyczne i złośliwe oprogramowanie.</string>
    <string name="hagezi_dns_blocklists_light">hagezi - Light</string>
    <string name="hagezi_dns_blocklists">hagezi\'s DNS-Blocklists</string>
    <string name="hagezi_dns_blocklists_light_description">Nie powinna prowadzić do żadnych ograniczeń i będzie zużywać najmniej zasobów systemowych.</string>
    <string name="hagezi_dns_blocklists_normal">hagezi - Normal</string>
    <string name="hagezi_dns_blocklists_normal_description">W większości przypadków nie powinna prowadzić do żadnych ograniczeń.</string>
    <string name="hagezi_dns_blocklists_pro">hagezi - Pro</string>
    <string name="hagezi_dns_blocklists_pro_description">Bardzo rzadko powinna prowadzić do ograniczeń. Konieczne może być odblokowanie określonych domen.</string>
    <string name="hagezi_dns_blocklists_pro_plus_plus">hagezi - Pro++</string>
    <string name="hagezi_dns_blocklists_pro_plus_plus_description">Może zawierać fałszywe dodatnie domeny. Powinna być używana tylko przez doświadczonych użytkowników, którzy w razie potrzeby mogą je odblokować.</string>
    <string name="hagezi_dns_blocklists_ultimate">hagezi - Ultimate</string>
    <string name="hagezi_dns_blocklists_ultimate_description">Ograniczy funkcjonalność wielu aplikacji i stron internetowych. Powinna być używana tylko przez bardzo doświadczonych użytkowników.</string>
    <string name="stevenblack_hosts">StevenBlack\'s hosts</string>
    <string name="stevenblack_hosts_description">Agreguje kilka źródeł do blokowania domen. Może psuć niektóre aplikacje.</string>
    <string name="stevenblack_hosts_adware_malware">StevenBlack - Adware + malware</string>
    <string name="stevenblack_hosts_gambling">StevenBlack - Gambling</string>
    <string name="stevenblack_hosts_nsfw">StevenBlack - Not safe for work</string>
    <string name="stevenblack_hosts_social_media">StevenBlack - Social media</string>
    <string name="oisd_description">Zwiększa prywatność przy jednoczesnym ograniczaniu reklam i złośliwego oprogramowania. Przekłada stabilność nad blokowanie.</string>
    <string name="oisd_big">osid - big</string>
    <string name="oisd_big_description">Pełna lista, która będzie zużywać znaczną ilość pamięci systemowej. Jeżeli nie wiesz, co to oznacza, wybierz listę \"oisd - small\".</string>
    <string name="oisd_small">oisd - small</string>
    <string name="oisd_small_description">Mniejsza wersja dużej listy, która zużywa mniej pamięci systemowej.</string>
