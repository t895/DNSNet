    <string name="use_dns_servers_from_active_network">செயலில் உள்ள நெட்வொர்க்கிலிருந்து சேவையகங்களைப் பயன்படுத்தவும்</string>
    <string name="use_dns_servers_from_active_network_description">உங்கள் சொந்த நெட்வொர்க்குடன் கூடுதலாக நீங்கள் இணைக்கப்பட்டுள்ள நெட்வொர்க்கிலிருந்து சேவையகங்களைப் பயன்படுத்துகிறது</string>
    <string name="presets">முன்னமைவுகள்</string>
    <string name="presets_description">நன்கு அறியப்பட்ட மற்றும் தொடர்ந்து புதுப்பிக்கப்பட்ட பிளாக் பட்டியல்களில் இருந்து எந்த வகையான உள்ளடக்கத்தைத் தடுக்க விரும்புகிறீர்கள் என்பதைத் தேர்ந்தெடுக்கவும்</string>
    <string name="select_an_option_to_continue">தொடர விருப்பத்தைத் தேர்ந்தெடுக்கவும்</string>
